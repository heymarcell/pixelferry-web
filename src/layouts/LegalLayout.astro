---
import BaseLayout from './BaseLayout.astro'
import BrandMark from '../components/landing/BrandMark.astro'
import Icon from '../components/Icon.astro'
import CookieConsent from '../components/CookieConsent.astro'
import JsonLd from '../components/seo/JsonLd.astro'
import { breadcrumbSchema, clean } from '../lib/schema'
import { cookieSchedule, type LegalDoc } from '../data/legal'
import { productLinks } from '../data/product'
import { PUBLIC_GTM_ID, PUBLIC_META_PIXEL_ID } from 'astro:env/client'

export interface Props {
  doc: LegalDoc
  current: '/privacy' | '/cookies'
  title: string
  description: string
}

const { doc, current, title, description } = Astro.props

const trackingConfigured = Boolean(PUBLIC_GTM_ID || PUBLIC_META_PIXEL_ID)

/*
 * The schedule lists only what the site actually sets. With no tag configured
 * the optional rows are omitted rather than described as present — a cookie
 * table that names cookies the site never sets is simply wrong.
 */
const rows = trackingConfigured
  ? [...cookieSchedule.alwaysSet, ...cookieSchedule.onConsent]
  : cookieSchedule.alwaysSet

const footerLinks = [
  { label: 'Privacy Policy', href: '/privacy' },
  { label: 'Cookie Policy', href: '/cookies' },
  { label: 'Contact', href: `mailto:${productLinks.privacyEmail}` },
]

const crumbs = [
  { name: 'PixelFerry', path: '/' },
  { name: doc.title, path: current },
]
---

<BaseLayout
  title={title}
  description={description}
  path={current}
  scheme="light"
  bodyClass="bg-doc-bg"
>
  <JsonLd slot="head" data={clean(breadcrumbSchema(crumbs))} />

  <div class="bg-doc-bg min-h-dvh">
    <header class="bg-void flex h-[74px] items-center justify-between px-5 sm:px-8 lg:px-16">
      <a href="/" class="flex items-center gap-2.5 rounded-lg" aria-label="PixelFerry — home">
        <BrandMark size={30} />
        <span class="font-display text-[21px] font-bold text-white">PixelFerry</span>
      </a>
      <a
        href="/"
        class="flex items-center gap-2 rounded text-[14px] font-semibold text-white/80 hover:text-white"
      >
        <Icon name="arrow-left" size={16} class="text-white/64" />
        Back to home
      </a>
    </header>

    <main id="main">
      <div
        class="border-doc-line bg-doc-panel border-b px-5 py-14 sm:px-8 lg:px-[180px] lg:pt-[72px] lg:pb-16"
      >
        <div class="mx-auto flex max-w-[1080px] flex-col items-start gap-4.5">
          <span
            class="rounded-full bg-[#FFF4E5] px-2.5 py-1.5 font-mono text-[10px] font-bold tracking-[0.7px] text-[#8A4B08] ring-1 ring-[#F59E0B33]"
          >
            DRAFT FOR LEGAL REVIEW
          </span>
          <h1
            class="font-display tracking-display text-doc-ink text-[clamp(2.25rem,4.4vw,3.5rem)] leading-[1.05] font-bold"
          >
            {doc.title}
          </h1>
          <p class="text-doc-body max-w-[800px] text-[18px] leading-[1.55]">{doc.intro}</p>
          <p class="text-doc-muted text-[14px] font-semibold">
            Effective date: <time datetime={doc.effectiveDate}>{doc.effectiveDate}</time>
          </p>
        </div>
      </div>

      <div class="px-5 py-16 sm:px-8 lg:px-[180px] lg:pt-16 lg:pb-24">
        <div class="mx-auto flex max-w-[1080px] flex-col gap-10 lg:flex-row lg:gap-14">
          <nav aria-label="Contents" class="lg:sticky lg:top-8 lg:h-fit lg:w-60 lg:shrink-0">
            <div class="border-doc-line bg-doc-panel flex flex-col gap-3.5 rounded-lg border p-5">
              <p class="text-doc-muted font-mono text-[10px] font-bold tracking-[1px]">CONTENTS</p>
              {
                doc.sections.map((section) => (
                  <a
                    href={`#${section.id}`}
                    class="text-doc-body hover:text-doc-ink aria-[current=true]:text-doc-link rounded text-[14px] font-medium transition-colors aria-[current=true]:font-bold"
                    data-toc-link={section.id}
                  >
                    {section.nav}
                  </a>
                ))
              }
            </div>
          </nav>

          <article class="flex max-w-[780px] min-w-0 flex-col gap-10">
            <div class="flex flex-col gap-3 rounded-lg border border-[#0062FF24] bg-[#E8F1FF] p-6">
              <h2 class="font-display text-[24px] font-bold text-[#003B9B]">{doc.summaryTitle}</h2>
              <p class="text-[16px] leading-[1.55] text-[#1E3A5F]">{doc.summaryBody}</p>
            </div>

            {
              doc.sections.map((section) => (
                <section id={section.id} class="flex scroll-mt-24 flex-col gap-3">
                  <h2 class="font-display text-doc-ink text-[clamp(1.375rem,2.2vw,1.75rem)] font-bold tracking-[-0.4px]">
                    {section.heading}
                  </h2>
                  {/* `pre-line` keeps the design's bullets and paragraph breaks byte-for-byte. */}
                  {/*
                   * Cloudflare Scrape Shield rewrites bare email addresses into
                   * `[email protected]` plus a JS decoder. On a site that works
                   * without JavaScript, that hides a legally required contact
                   * address from anyone with JS off. These are Cloudflare's
                   * documented opt-out markers; the body stays escaped text.
                   */}
                  <Fragment set:html="<!--email_off-->" />
                  <p class="text-doc-body text-[16px] leading-[1.65] whitespace-pre-line">
                    {section.body}
                  </p>
                  <Fragment set:html="<!--/email_off-->" />

                  {section.id === 'cookie-schedule' && (
                    <>
                      {/* tabindex + a name: a horizontally scrollable region has
                        to be reachable and scrollable from the keyboard. */}
                      <div
                        tabindex="0"
                        role="region"
                        aria-label="Cookie schedule"
                        class="border-doc-line bg-doc-panel overflow-x-auto rounded-lg border"
                      >
                        <table class="w-full min-w-[720px] border-collapse text-left text-[13px]">
                          <caption class="sr-only">
                            Cookies and similar technologies set by pixelferry.app
                          </caption>
                          <thead class="bg-[#F1F3F7] text-[#374151]">
                            <tr>
                              {['Name', 'Provider', 'Purpose', 'Category', 'Duration'].map(
                                (header) => (
                                  <th
                                    scope="col"
                                    class="border-doc-line border-r px-2.5 py-3 font-semibold last:border-r-0"
                                  >
                                    {header}
                                  </th>
                                ),
                              )}
                            </tr>
                          </thead>
                          <tbody class="text-doc-body">
                            {rows.map((row) => (
                              <tr class="border-doc-line border-t">
                                <th
                                  scope="row"
                                  class="border-doc-line text-doc-ink border-r px-2.5 py-3.5 text-left font-mono text-[12px] font-normal"
                                >
                                  {row.name}
                                </th>
                                <td class="border-doc-line border-r px-2.5 py-3.5">
                                  {row.provider}
                                </td>
                                <td class="border-doc-line border-r px-2.5 py-3.5">
                                  {row.purpose}
                                </td>
                                <td class="border-doc-line border-r px-2.5 py-3.5">
                                  {row.category}
                                </td>
                                <td class="px-2.5 py-3.5">{row.duration}</td>
                              </tr>
                            ))}
                          </tbody>
                        </table>
                      </div>

                      {trackingConfigured && (
                        <button
                          type="button"
                          data-cookie-settings
                          class="text-doc-link mt-1 self-start rounded text-[14px] font-bold underline-offset-4 hover:underline"
                        >
                          Change your cookie choices
                        </button>
                      )}
                    </>
                  )}
                </section>
              ))
            }
          </article>
        </div>
      </div>
    </main>

    <footer class="bg-void px-5 py-8 sm:px-8 lg:px-16">
      <div
        class="mx-auto flex max-w-[1312px] flex-col items-center gap-4 sm:flex-row sm:justify-between"
      >
        <p class="text-[13px] font-medium text-white/56">© 2026 PixelFerry</p>
        {/* Contact is a `mailto:` — see the note above the body markers. */}
        <Fragment set:html="<!--email_off-->" />
        <nav aria-label="Legal" class="flex flex-wrap items-center justify-center gap-6">
          {
            footerLinks.map((link) => (
              <a
                href={link.href}
                aria-current={link.href === current ? 'page' : undefined}
                class:list={[
                  'rounded text-[13px] font-semibold',
                  link.href === current ? 'text-white' : 'text-white/64 hover:text-white',
                ]}
              >
                {link.label}
              </a>
            ))
          }
        </nav>
        <Fragment set:html="<!--/email_off-->" />
      </div>
    </footer>
  </div>

  <CookieConsent />
</BaseLayout>

<script>
  /*
   * Highlights the section currently under the header. Pure enhancement: the
   * contents list is a plain set of anchor links and works untouched without
   * this.
   */
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'))
  const sections = links
    .map((link) => document.getElementById(link.dataset.tocLink ?? ''))
    .filter((el): el is HTMLElement => el !== null)

  if (sections.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0]
        if (!visible) return
        for (const link of links) {
          link.setAttribute('aria-current', String(link.dataset.tocLink === visible.target.id))
        }
      },
      { rootMargin: '-96px 0px -70% 0px' },
    )
    for (const section of sections) observer.observe(section)
  }
</script>
