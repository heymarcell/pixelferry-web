---
import Icon from './Icon.astro'
import ConsentBoot from './ConsentBoot.astro'
import { PUBLIC_GTM_ID, PUBLIC_META_PIXEL_ID } from 'astro:env/client'

/**
 * The cookie banner.
 *
 * Renders NOTHING — no markup, no script, no Consent Mode defaults — unless a
 * tag ID is configured. Showing a banner for storage that does not exist would
 * be misleading, and it is why the default build is 0 bytes of consent code.
 *
 * When it does render: prior blocking, symmetric refusal (reject is the same
 * size and prominence as accept, and there is no dismiss-to-consent), and
 * withdrawal via the footer link.
 */
const trackingConfigured = Boolean(PUBLIC_GTM_ID || PUBLIC_META_PIXEL_ID)

const categories = [
  {
    key: 'analytics',
    label: 'Analytics',
    description:
      'Google Analytics, loaded through Google Tag Manager, to measure visits and improve the launch page.',
  },
  {
    key: 'marketing',
    label: 'Marketing',
    description: 'Meta Pixel, used to measure and target advertising for the launch.',
  },
]

const btn =
  'h-[42px] w-full rounded-md px-4 text-[14px] font-bold transition-colors duration-150 sm:w-40'
---

{
  trackingConfigured && (
    <div
      data-cookie-banner
      hidden
      role="dialog"
      aria-modal="false"
      aria-labelledby="cookie-banner-title"
      class="fixed inset-x-0 bottom-0 z-[100] bg-[#11141D] px-5 py-6 shadow-[0_-8px_24px_#00000066] ring-1 ring-white/12 sm:px-8 lg:px-12"
    >
      <div class="mx-auto flex max-w-[1344px] flex-col gap-6 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <div class="flex min-w-0 flex-col gap-2.5">
          <div class="flex items-center gap-2.5">
            <span class="bg-blue/12 text-blue-soft grid size-[34px] shrink-0 place-items-center rounded-lg shadow-[inset_0_0_0_1px_#0062FF33]">
              <Icon name="shield-check" size={19} />
            </span>
            <h2 id="cookie-banner-title" class="font-display text-[19px] font-bold text-white">
              We use cookies
            </h2>
          </div>

          <p class="max-w-[760px] text-[14px] leading-[1.5] text-white/70">
            Essential cookies keep the waitlist working. With your permission, analytics help us
            understand visits and improve the launch page.
          </p>

          <ul data-cookie-detail hidden class="flex list-none flex-col gap-3 pt-2">
            <li class="flex items-start gap-3 text-[13px] text-white/64">
              <span class="mt-0.5 rounded bg-white/10 px-2 py-0.5 text-[11px] font-semibold text-white/70">
                Always on
              </span>
              <span>
                Strictly necessary: security, routing, the waitlist form, and this choice.
              </span>
            </li>
            {categories.map((category) => (
              <li class="flex items-start gap-3">
                <input
                  id={`consent-${category.key}`}
                  data-consent-category={category.key}
                  type="checkbox"
                  class="accent-blue mt-0.5 size-[18px] shrink-0"
                />
                <label
                  for={`consent-${category.key}`}
                  class="text-[13px] leading-[1.45] text-white/70"
                >
                  <span class="font-semibold text-white/90">{category.label}</span> —{' '}
                  {category.description}
                </label>
              </li>
            ))}
          </ul>

          <div class="flex flex-wrap items-center gap-4.5 pt-1">
            <a
              href="/privacy"
              class="rounded text-[13px] font-semibold text-white/64 hover:text-white"
            >
              Privacy policy
            </a>
            <a
              href="/cookies"
              class="rounded text-[13px] font-semibold text-white/64 hover:text-white"
            >
              Cookie policy
            </a>
          </div>
        </div>

        {/* Refusing is exactly as easy as accepting — same size, same prominence. */}
        <div class="flex shrink-0 flex-col gap-2.5 sm:flex-row lg:w-[520px] lg:justify-end">
          <button
            type="button"
            data-consent-action="reject"
            class={`${btn} bg-[#242934] text-white/85 ring-1 ring-white/17 hover:bg-[#2c323f]`}
          >
            Reject optional
          </button>
          <button
            type="button"
            data-consent-action="manage"
            class={`${btn} bg-[#11141D] text-white/85 ring-1 ring-white/17 hover:bg-[#191d28]`}
          >
            Manage choices
          </button>
          <button
            type="button"
            data-consent-action="save"
            hidden
            class={`${btn} bg-[#11141D] text-white/85 ring-1 ring-white/17 hover:bg-[#191d28]`}
          >
            Save choices
          </button>
          <button
            type="button"
            data-consent-action="accept"
            class={`${btn} bg-blue text-white shadow-[0_5px_14px_-4px_#0062FF45] hover:bg-[#1A73FF]`}
          >
            Accept optional
          </button>
        </div>
      </div>
    </div>
  )
}

{trackingConfigured && <ConsentBoot />}
