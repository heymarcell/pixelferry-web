---
import AppPreview from '../preview/AppPreview.astro'
---

<section id="preview" class="px-5 pb-20 sm:px-8 md:pb-[110px] lg:px-16">
  <div class="mx-auto flex max-w-[1312px] flex-col items-center gap-7">
    <h2 data-reveal class="flex flex-wrap items-center justify-center gap-2.5 text-center">
      <span class="text-blue-soft font-mono text-[11px] font-bold tracking-[1.2px]"
        >A FIRST LOOK</span
      >
      <span aria-hidden="true" class="h-px w-14 bg-[#7FA4FF66]"></span>
      <span class="text-[14px] font-semibold text-white/70">One queue. One set of rules.</span>
    </h2>

    <AppPreview />

    <p class="text-center text-[12px] leading-[1.5] text-white/45">
      An illustration of the interface, not a screenshot. The file sizes shown are examples.
    </p>
  </div>
</section>
