---
/**
 * The PixelFerry compact mark (Pencil component `Brand/CompactMark`).
 * The glyph is authored on a 68×73 grid and stretched into a slightly
 * narrower box by the design, so `preserveAspectRatio` stays off.
 *
 * Sizes come through CSS custom properties on a class rather than a `style`
 * attribute, because `style-src` carries no 'unsafe-inline'.
 */
export interface Props {
  size?: 30 | 26
}

const { size = 30 } = Astro.props
const cls = size === 30 ? 'brand-mark brand-mark--lg' : 'brand-mark brand-mark--sm'
---

<span aria-hidden="true" class={cls}>
  {/* The 30-unit viewBox keeps the glyph's inset proportional at any size. */}
  <svg width="100%" height="100%" viewBox="0 0 30 30" fill="none">
    <svg x="8" y="7" width="14" height="15.8" viewBox="0 0 68 73" preserveAspectRatio="none">
      <path
        fill-rule="evenodd"
        clip-rule="evenodd"
        d="M0 0h34c4 0 7 2 10 5l19 17c3 2 3 6 0 9l-19 17c-3 3-6 5-10 5h-16v20h-18z m18 18h19.5c4 0 7 3 7 7v3c0 4-3 7-7 7h-19.5z"
        fill="#fff"></path>
    </svg>
  </svg>
</span>

<style>
  .brand-mark {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    background-color: var(--color-brand);
    box-shadow:
      inset 0 0 0 1px #ffffff24,
      0 2px 4px #0000000d,
      0 6px 14px #00000012;
  }

  .brand-mark--lg {
    width: 30px;
    height: 30px;
    border-radius: 8px;
  }

  .brand-mark--sm {
    width: 26px;
    height: 26px;
    border-radius: 7px;
  }
</style>
