---
import { getCollection } from 'astro:content'
import ContentLayout from '../layouts/ContentLayout.astro'
import WaitlistCta from '../components/content/WaitlistCta.astro'
import {
  formats,
  groups,
  writableFormats,
  readOnlyFormats,
  macOSOnlyReadFormats,
  macOSOnlyWriteFormats,
  formatCounts,
  capabilityOf,
  limits,
  product,
  type Format,
} from '../data/product'

/**
 * The complete supported-format reference, rendered from `src/data/formats.ts`.
 *
 * "Complete" is meant literally: every extension the app accepts appears here,
 * grouped for readability. Read and write are shown separately per format
 * because they differ — ICO is read only on macOS but written anywhere; HEIC is
 * read anywhere but written only on macOS. `test/format-model.test.ts` asserts
 * this page's model covers the app's full extension list at the pinned commit.
 */

const conversions = await getCollection('conversions')

/** Conversion pages available FROM a given format, matched on its label. */
function conversionsFrom(format: Format) {
  const key = format.label.split(' / ')[0]!.replace('Camera ', '').toUpperCase()
  return conversions.filter((entry) => entry.data.from.toUpperCase() === key)
}

function readCell(format: Format) {
  if (format.read === 'anywhere') return { text: 'Yes', tone: 'yes' }
  if (format.read === 'macos') return { text: 'macOS only', tone: 'mac' }
  return { text: 'No', tone: 'no' }
}

function writeCell(format: Format) {
  if (format.write === 'anywhere') return { text: 'Yes', tone: 'yes' }
  if (format.write === 'macos') return { text: 'macOS only', tone: 'mac' }
  return { text: 'No', tone: 'no' }
}

const toneClass: Record<string, string> = {
  yes: 'text-[#146B30]',
  mac: 'text-doc-link',
  no: 'text-doc-muted',
}
---

<ContentLayout
  title="Supported image formats — PixelFerry for macOS"
  description={`Every image format PixelFerry reads and writes — ${formatCounts.extensions} extensions in ${formatCounts.readable} families — which are macOS-only, and the exact limitations.`}
  path="/formats"
  heading="Supported formats"
  summary={`PixelFerry reads ${formatCounts.readable} format families covering ${formatCounts.extensions} file extensions, and writes ${formatCounts.writable}. This is the complete list — including the ones that only work on macOS, and the ones you can read but not write.`}
  eyebrow="REFERENCE"
  crumbs={[{ name: 'PixelFerry', path: '/' }]}
>
  <div class="flex flex-col gap-14 lg:flex-row lg:gap-14">
    <div class="flex min-w-0 flex-1 flex-col gap-12">
      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Formats PixelFerry can write
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          Any input can be converted to any of these. Everything else on this page can be read but
          not written.
        </p>
        <ul class="grid list-none gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            writableFormats.map((format) => (
              <li class="border-doc-line bg-doc-panel rounded-lg border p-4">
                <span class="text-doc-ink font-mono text-[13px] font-bold">{format.label}</span>
                {format.write === 'macos' && (
                  <span class="text-doc-link ml-1.5 text-[11px] font-semibold">macOS only</span>
                )}
                <p class="text-doc-body mt-1 text-[13px] leading-[1.45]">{format.summary}</p>
                {format.quality && (
                  <p class="text-doc-muted mt-1 text-[12px]">
                    Quality {limits.quality.min}–{limits.quality.max}
                  </p>
                )}
              </li>
            ))
          }
        </ul>
      </section>

      {/* ── The complete matrix ── */}
      {
        groups.map((group) => {
          const rows = formats.filter((format) => format.group === group)
          return (
            <section class="flex flex-col gap-4">
              <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
                {group}
              </h2>
              <div
                tabindex="0"
                role="region"
                aria-label={`${group} formats`}
                class="border-doc-line bg-doc-panel overflow-x-auto rounded-lg border"
              >
                <table class="w-full min-w-[680px] border-collapse text-left text-[14px]">
                  <caption class="sr-only">{group}: read and write support</caption>
                  <thead class="bg-[#F1F3F7] text-[#374151]">
                    <tr>
                      <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">
                        Format
                      </th>
                      <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">
                        Read
                      </th>
                      <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">
                        Write
                      </th>
                      <th scope="col" class="px-3 py-3 font-semibold">
                        Extensions and notes
                      </th>
                    </tr>
                  </thead>
                  <tbody class="text-doc-body">
                    {rows.map((format) => (
                      <tr class="border-doc-line border-t align-top">
                        <th
                          scope="row"
                          class="border-doc-line text-doc-ink border-r px-3 py-3.5 text-left font-semibold"
                        >
                          {format.label}
                        </th>
                        <td
                          class:list={[
                            'border-doc-line border-r px-3 py-3.5 font-semibold',
                            toneClass[readCell(format).tone],
                          ]}
                        >
                          {readCell(format).text}
                        </td>
                        <td
                          class:list={[
                            'border-doc-line border-r px-3 py-3.5 font-semibold',
                            toneClass[writeCell(format).tone],
                          ]}
                        >
                          {writeCell(format).text}
                        </td>
                        <td class="px-3 py-3.5">
                          <span class="text-doc-muted block font-mono text-[12px]">
                            {format.extensions.map((ext) => `.${ext}`).join(' ')}
                          </span>
                          <span class="mt-1 block">{format.summary}</span>
                          {format.caveat && (
                            <span class="text-doc-muted mt-1 block text-[13px]">
                              {format.caveat}
                            </span>
                          )}
                          {conversionsFrom(format).length > 0 && (
                            <span class="mt-1.5 block text-[13px]">
                              {conversionsFrom(format).map((entry, i) => (
                                <>
                                  {i > 0 && <span class="text-doc-muted"> · </span>}
                                  <a
                                    href={`/convert/${entry.id}`}
                                    class="text-doc-link font-semibold hover:underline"
                                  >
                                    to {entry.data.to}
                                  </a>
                                </>
                              ))}
                            </span>
                          )}
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </section>
          )
        })
      }

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Limitations, stated up front
        </h2>
        <ul class="flex list-none flex-col gap-3">
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              {readOnlyFormats.length} families are read but never written
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              {readOnlyFormats.map((f) => f.label).join(', ')}. PixelFerry converts <em>from</em>
              {' '}them, not <em>to</em> them.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">Writing HEIC needs macOS</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              {macOSOnlyWriteFormats.map((f) => f.label).join(', ')} — the encode goes through the system
              <code class="font-mono text-[13px]">sips</code> tool, so it is available on macOS only.
              Reading HEIC works anywhere.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              {macOSOnlyReadFormats.length} families need macOS to read
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Camera RAW, EXR, BMP, TGA, ICO, JPEG XL, JPEG 2000 and the rest decode through macOS
              ImageIO. There is no bundled cross-platform loader for them, so off macOS they fail
              with a clear error rather than pretending to work. ICO is the exception in the other
              direction: reading it needs macOS, but PixelFerry writes it anywhere.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              PDFs stop at {limits.pdfPageCap} pages
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Each page becomes its own image in a folder named after the document. Rendering is
              held in memory, so long documents are capped at the first {limits.pdfPageCap} pages — and
              the conversion says so rather than truncating silently.
              <a href="/convert/pdf-to-png" class="text-doc-link font-semibold hover:underline">
                More on PDF conversion</a
              >.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">PSD files are flattened</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Conversion uses the composite Photoshop stores in the file, so the result reflects the
              document exactly as it was last saved. Hidden layers stay hidden.
              <a href="/convert/psd-to-png" class="text-doc-link font-semibold hover:underline">
                More on PSD conversion</a
              >.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              JPEG output flattens transparency onto white
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              JPEG has no alpha channel. White is used rather than the black most image libraries
              default to, which is what you want for a photo and not what you want for a logo —
              target PNG, WebP or AVIF for those.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">Animation is conditional</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Animated GIF and WebP keep every frame when the target also supports animation.
              Otherwise the first frame is written and the row says so.
            </p>
          </li>
        </ul>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Requirements
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          {product.minimumOS.label}, on {product.architectures}. macOS only — Windows and Linux
          targets exist in the codebase but have never been built, signed or tested, so they are not
          offered rather than promised untested.
        </p>
        <p class="text-doc-muted max-w-[720px] text-[14px] leading-[1.6]">
          The read/write columns above distinguish what the conversion engine can do from what needs
          macOS specifically, because the cross-platform code paths remain in the app even though
          only the macOS build ships.
        </p>
      </section>
    </div>

    <aside class="w-full shrink-0 lg:w-[280px]">
      <WaitlistCta />
    </aside>
  </div>
</ContentLayout>
