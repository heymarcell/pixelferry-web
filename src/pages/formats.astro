---
import { getCollection } from 'astro:content'
import ContentLayout from '../layouts/ContentLayout.astro'
import WaitlistCta from '../components/content/WaitlistCta.astro'
import { inputFormats, outputFormats, inputOnlyFormats, limits, product } from '../data/product'

const crossPlatform = inputFormats.filter((format) => !format.macOSOnly)
const macOnly = inputFormats.filter((format) => format.macOSOnly)

const conversions = await getCollection('conversions')
/** Index conversion pages by source label so each row can link to its page. */
const bySource = new Map<string, typeof conversions>()
for (const entry of conversions) {
  const key = entry.data.from.toUpperCase()
  const existing = bySource.get(key)
  if (existing) existing.push(entry)
  else bySource.set(key, [entry])
}

function conversionsFor(label: string) {
  // 'HEIC / HEIF' and 'Camera RAW' need normalising onto the page slugs.
  const key = label.split(' / ')[0]!.replace('Camera ', '').toUpperCase()
  return bySource.get(key) ?? []
}
---

<ContentLayout
  title="Supported image formats — PixelFerry for macOS"
  description="Every image format PixelFerry reads and writes, which ones are macOS-only, which are input-only, and the exact limitations for PDF, PSD and camera RAW."
  path="/formats"
  heading="Supported formats"
  summary={`PixelFerry reads ${inputFormats.length} format families and writes ${outputFormats.length}. This is the complete list, including the ones that only work on macOS and the ones you can convert from but not to.`}
  eyebrow="REFERENCE"
  crumbs={[{ name: 'PixelFerry', path: '/' }]}
>
  <div class="flex flex-col gap-14 lg:flex-row lg:gap-14">
    <div class="flex min-w-0 flex-1 flex-col gap-12">
      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Formats PixelFerry can write
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          Any input can be converted to any of these. Everything else on this page is read-only.
        </p>
        <ul class="grid list-none gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {
            outputFormats.map((format) => (
              <li class="border-doc-line bg-doc-panel rounded-lg border p-4">
                <span class="text-doc-ink font-mono text-[13px] font-bold">{format.label}</span>
                <p class="text-doc-body mt-1 text-[13px] leading-[1.45]">{format.summary}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Formats PixelFerry can read
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          These work on any platform the app runs on, decoded by the bundled image pipeline.
        </p>
        <div
          tabindex="0"
          role="region"
          aria-label="Cross-platform input formats"
          class="border-doc-line bg-doc-panel overflow-x-auto rounded-lg border"
        >
          <table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
            <caption class="sr-only">Cross-platform input formats</caption>
            <thead class="bg-[#F1F3F7] text-[#374151]">
              <tr>
                <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">Format</th>
                <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">
                  Extensions
                </th>
                <th scope="col" class="px-3 py-3 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody class="text-doc-body">
              {
                crossPlatform.map((format) => (
                  <tr class="border-doc-line border-t align-top">
                    <th
                      scope="row"
                      class="border-doc-line text-doc-ink border-r px-3 py-3.5 text-left font-semibold"
                    >
                      {format.label}
                    </th>
                    <td class="border-doc-line border-r px-3 py-3.5 font-mono text-[12px]">
                      {format.extensions.map((ext) => `.${ext}`).join(' ')}
                    </td>
                    <td class="px-3 py-3.5">
                      {format.summary}
                      {format.caveat && (
                        <span class="text-doc-muted mt-1 block text-[13px]">{format.caveat}</span>
                      )}
                      {conversionsFor(format.label).length > 0 && (
                        <span class="mt-1.5 block text-[13px]">
                          {conversionsFor(format.label).map((entry, i) => (
                            <>
                              {i > 0 && <span class="text-doc-muted"> · </span>}
                              <a
                                href={`/convert/${entry.id}`}
                                class="text-doc-link font-semibold hover:underline"
                              >
                                to {entry.data.to}
                              </a>
                            </>
                          ))}
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          macOS-only formats
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          These decode through macOS ImageIO — the same system component Finder and Preview use.
          There is no bundled cross-platform decoder for them, so off macOS they fail with a clear
          error rather than pretending to work.
        </p>
        <div
          tabindex="0"
          role="region"
          aria-label="Input formats that require macOS"
          class="border-doc-line bg-doc-panel overflow-x-auto rounded-lg border"
        >
          <table class="w-full min-w-[640px] border-collapse text-left text-[14px]">
            <caption class="sr-only">Input formats that require macOS</caption>
            <thead class="bg-[#F1F3F7] text-[#374151]">
              <tr>
                <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">Format</th>
                <th scope="col" class="border-doc-line border-r px-3 py-3 font-semibold">
                  Extensions
                </th>
                <th scope="col" class="px-3 py-3 font-semibold">Notes</th>
              </tr>
            </thead>
            <tbody class="text-doc-body">
              {
                macOnly.map((format) => (
                  <tr class="border-doc-line border-t align-top">
                    <th
                      scope="row"
                      class="border-doc-line text-doc-ink border-r px-3 py-3.5 text-left font-semibold"
                    >
                      {format.label}
                    </th>
                    <td class="border-doc-line border-r px-3 py-3.5 font-mono text-[12px]">
                      {format.extensions.map((ext) => `.${ext}`).join(' ')}
                    </td>
                    <td class="px-3 py-3.5">
                      {format.summary}
                      {format.caveat && (
                        <span class="text-doc-muted mt-1 block text-[13px]">{format.caveat}</span>
                      )}
                      {conversionsFor(format.label).length > 0 && (
                        <span class="mt-1.5 block text-[13px]">
                          {conversionsFor(format.label).map((entry, i) => (
                            <>
                              {i > 0 && <span class="text-doc-muted"> · </span>}
                              <a
                                href={`/convert/${entry.id}`}
                                class="text-doc-link font-semibold hover:underline"
                              >
                                to {entry.data.to}
                              </a>
                            </>
                          ))}
                        </span>
                      )}
                    </td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="flex flex-col gap-4">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Limitations, stated up front
        </h2>
        <ul class="flex list-none flex-col gap-3">
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">Input-only formats</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              {inputOnlyFormats.join(', ')} can be converted <em>from</em> but never <em>to</em>.
              PixelFerry will not write a HEIC, a layered PSD, a PDF or a vector SVG.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              PDFs stop at {limits.pdfPageCap} pages
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Each page becomes its own image in a folder named after the document. Rendering is
              held in memory, so long documents are capped at the first {limits.pdfPageCap} pages — and
              the conversion says so rather than truncating silently.
              <a href="/convert/pdf-to-png" class="text-doc-link font-semibold hover:underline">
                More on PDF conversion</a
              >.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">PSD files are flattened</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Conversion uses the composite Photoshop stores in the file, so the result reflects the
              document exactly as it was last saved. Hidden layers stay hidden.
              <a href="/convert/psd-to-png" class="text-doc-link font-semibold hover:underline">
                More on PSD conversion</a
              >.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">
              JPEG output flattens transparency onto white
            </p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              JPEG has no alpha channel. White is used rather than the black most image libraries
              default to, which is what you want for a photo and not what you want for a logo —
              target PNG or WebP for those.
            </p>
          </li>
          <li class="border-doc-line bg-doc-panel rounded-lg border p-5">
            <p class="font-display text-doc-ink text-[16px] font-bold">Animation is conditional</p>
            <p class="text-doc-body mt-1.5 text-[15px] leading-[1.6]">
              Animated GIF and WebP keep every frame when the target also supports animation.
              Otherwise the first frame is written and the row says so.
            </p>
          </li>
        </ul>
      </section>

      <section class="flex flex-col gap-3">
        <h2 class="font-display text-doc-ink text-[24px] font-bold tracking-[-0.4px]">
          Requirements
        </h2>
        <p class="text-doc-body max-w-[720px] text-[16px] leading-[1.6]">
          {product.minimumOS.label}, on {product.architectures}. macOS only — Windows and Linux
          targets exist in the codebase but have never been built, signed or tested, so they are not
          offered rather than promised untested.
        </p>
      </section>
    </div>

    <aside class="w-full shrink-0 lg:w-[280px]">
      <WaitlistCta />
    </aside>
  </div>
</ContentLayout>
