# Cloudflare Workers Static Assets serves these as real response headers.
#
# ── The CSP has NO 'unsafe-inline' ──────────────────────────────────────────
#
# The previous site needed it in script-src for an inline Consent Mode snippet,
# and in style-src for Astro's inlined stylesheets. Both are gone:
#
#   * every first-party script is an external bundled module
#     (vite.build.assetsInlineLimit: 0 in astro.config.mjs),
#   * every stylesheet is external (build.inlineStylesheets: 'never'),
#   * markdown code blocks are not syntax-highlighted, because Shiki writes a
#     `style` attribute on every token,
#   * no component uses a `style` attribute; per-element values are classes.
#
# `npm run audit:seo` fails the build if any of those regress, and
# `test/e2e/security.spec.ts` fails on a real CSP violation in the browser. So
# this is verified, not aspirational — do not add 'unsafe-inline' back to make
# a change easier.
#
# ── Turnstile ───────────────────────────────────────────────────────────────
#
# challenges.cloudflare.com is needed in BOTH script-src (the api.js the form
# loads at first interaction) and frame-src (the challenge renders in an
# iframe). Omit either and the widget silently fails to verify.
#
# ── If you ever enable a tag ────────────────────────────────────────────────
#
# Setting PUBLIC_GTM_ID or PUBLIC_META_PIXEL_ID will be BLOCKED by this policy
# until the relevant origins are added to script-src / img-src / connect-src.
# That is deliberate: a tag must not be able to start loading without the
# policy — and the Privacy and Cookie policies — being updated in the same
# change. See docs/deployment.md.
#
# img-src needs data: for the consent checkbox tick, which is an inline SVG.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pixelferry.app; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), display-capture=(), geolocation=(), gyroscope=(), interest-cohort=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

# Fingerprinted build output. The hash is in the filename, so the content at a
# given URL can never change and a year is safe. HTML is deliberately NOT
# given a cache rule: it must stay revalidatable or a deploy goes stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Stable, unfingerprinted brand assets. A day is long enough to be useful and
# short enough that replacing the mark does not need a cache purge.
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
/favicon-96.png
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/og.jpg
  Cache-Control: public, max-age=86400
