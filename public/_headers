# Cloudflare Pages serves these as real response headers.
#
# Turnstile needs challenges.cloudflare.com in BOTH script-src (the api.js it
# loads) and frame-src (the challenge renders in an iframe) — omit either and
# the widget silently fails to verify.
#
# 'unsafe-inline' in script-src is required by the inline gtag consent-default
# block in index.html, which must run before any tag loads. Hashes were rejected
# because they would need regenerating on every copy change and a stale hash
# fails closed — silently disabling the consent defaults.
#
# img-src needs data: for the consent checkbox tick, which is an inline SVG.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.pixelferry.app; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
