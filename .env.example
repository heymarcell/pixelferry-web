# ─── Waitlist ────────────────────────────────────────────────────────────────
# Where the hero form sends signups. When unset the form falls back to a
# mailto: link instead of pretending a signup succeeded.
VITE_WAITLIST_ENDPOINT=

# Address used by that mailto: fallback.
VITE_WAITLIST_MAILTO=beta@pixelferry.app

# 'json' (default) POSTs {email, source, consent{...}} and reads the status code.
# 'form' POSTs an urlencoded body to a provider form endpoint (Brevo,
# MailerLite, EmailOctopus). Those endpoints send no CORS headers, so the
# response is opaque — acceptable only because double opt-in means the real
# confirmation happens over email.
VITE_WAITLIST_FORMAT=json

# Field name the provider expects for the address in 'form' mode.
VITE_WAITLIST_EMAIL_FIELD=EMAIL


# ─── Tracking (optional, consent-gated) ──────────────────────────────────────
# Leave BOTH unset and the site loads no tags and shows no cookie banner —
# which is the correct state while nothing non-essential is stored.
#
# ⚠ Before setting either of these, the Privacy Policy and Cookie Policy MUST be
# revised. As written they state the site uses no analytics or marketing
# technologies, which stops being true the moment these are configured.
VITE_GTM_ID=
VITE_META_PIXEL_ID=
